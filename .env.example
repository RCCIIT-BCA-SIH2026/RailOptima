# POSTGRES_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/railway_planner

# Authentication & Security
JWT_SECRET=ir-production-secret-key-2026-sih-ai-block-planner
SECRET_KEY=ir-production-secret-key-2026-sih-ai-block-planner
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project Metadata
PROJECT_NAME="AI-Powered Automatic Block Planning System for Indian Railways"
PROJECT_VERSION=1.0.0
SIH_PROBLEM_CODE=SIH26027
DATA_MODE_LABEL="SIMULATED DEMO DATA"

# Google Gemini AI Keys (Agentic RAG Engine)
